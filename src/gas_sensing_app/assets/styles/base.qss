*[textColor="primary"] {
  color: #3498db;
}

*[textColor="secondary"] {
  color: #95a5a6;
}

*[textColor="success"] {
  color: #27ae60;
}

*[textColor="info"] {
  color: #00bcd4;
}

*[textColor="warning"] {
  color: #f1c40f;
}

*[textColor="danger"] {
  color: #e74c3c;
}

*[fontWeight="bold"] {
  font-weight: bold;
}

*[fontWeight="normal"] {
  font-weight: normal;
}

QTabBar::tab {
  padding: 8px 16px;
  border-bottom: none;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QGroupBox {
  border-radius: 6px;
  margin-top: 15px;
  font-weight: bold;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 5px;
}

QSpinBox {
  border-radius: 5px;
  padding: 5px 35px 5px 10px;
  min-height: 24px;
}

QSpinBox::up-button,
QSpinBox::down-button {
  width: 22px;
}

QSpinBox::up-button {
  border-top-right-radius: 5px;
}

QSpinBox::down-button {
  border-bottom-right-radius: 5px;
}

QSpinBox::up-arrow {
  image: url("@SPINBOX_UP@");
  width: 10px;
  height: 6px;
}

QSpinBox::down-arrow {
  image: url("@SPINBOX_DOWN@");
  width: 10px;
  height: 6px;
}

QComboBox {
  border-radius: 5px;
  padding: 5px 10px;
  padding-right: 30px;
}

QComboBox::drop-down {
  width: 28px;
  border-top-right-radius: 5px;
  border-bottom-right-radius: 5px;
}

QComboBox::down-arrow {
  image: url("@COMBOBOX_ARROW@");
  width: 12px;
  height: 8px;
}

QComboBox QAbstractItemView {
  border-radius: 4px;
  padding: 2px;
}

QComboBox QAbstractItemView::item {
  padding: 6px 10px;
}

QCheckBox {
  spacing: 8px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border-radius: 3px;
}

QCheckBox::indicator:checked {
  image: url("@CHECK_ICON@");
}

QPushButton {
  font-weight: bold;
  height: 35px;
}

/* Named components */

QLabel#statusLabel {
  font-weight: bold;
  padding: 5px;
  font-size: 13px;
}

QLabel#resistanceLabel {
  font-size: 32px;
  padding: 10px;
}

QPushButton#runRecipeButton {
  height: 45px;
}

QCheckBox#openShutterCheckBox {
  font-weight: bold;
}

QPushButton#stopButton {
  height: 40px;
}

QTextEdit#consoleLogText {
  font-size: 11px;
}

QCheckBox[plotCheckBox="true"] {
  font-weight: bold;
  margin-right: 15px;
}
