QTabBar::tab {
  padding: 8px 16px;
  border-bottom: none;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}

QGroupBox {
  border-radius: 6px;
  margin-top: 15px;
  font-weight: bold;
}

QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 10px;
  padding: 0 5px;
}

QSpinBox {
  padding: 5px;
  border-radius: 4px;
}
