QMainWindow {
  background-color: #121212;
}

QWidget {
  background-color: #1e1e1e;
  color: #e0e0e0;
}

QFrame {
  background-color: #1e1e1e;
  border: 1px solid #2d2d2d;
}

QTabWidget::pane {
  border: 1px solid #333333;
  background-color: #1e1e1e;
}

QTabBar::tab {
  background-color: #252525;
  color: #9aa4ad;
  border: 1px solid #333333;
  padding: 6px 12px;
}

QTabBar::tab:hover {
  color: #e0e0e0;
  background-color: #303030;
}

QTabBar::tab:selected {
  background-color: #1e1e1e;
  color: #ffffff;
  border-bottom: 2px solid #3498db;
}

QGroupBox {
  border: 1px solid #3a3a3a;
  border-radius: 4px;
  margin-top: 8px;
}

QGroupBox::title {
  color: #b8c2cc;
}

QLabel {
  background-color: transparent;
  color: #e0e0e0;
}

QPushButton {
  color: #ffffff;
  border-radius: 4px;
  border: 1px solid transparent;
  padding: 6px 12px;
}

QPushButton:hover {
  border: 1px solid #dddddd;
}

QPushButton:disabled {
  background-color: #333333;
  color: #777777;
  border: 1px solid #444444;
}

QPushButton:hover:disabled {
  background-color: inherit;
}

QComboBox {
  background-color: #252525;
  color: #e0e0e0;
  border: 1px solid #3a3a3a;
  border-radius: 4px;
  padding: 5px 10px;
}

QComboBox:hover {
  border-color: #4cc9f0;
}

QComboBox:focus {
  border: 2px solid #3498db;
}

QComboBox::drop-down {
  width: 24px;
  border: none;
  background-color: #2d2d2d;
  border-left: 1px solid #3a3a3a;
}

QComboBox::drop-down:hover {
  background-color: #383838;
}

QComboBox QAbstractItemView {
  background-color: #252525;
  color: #e0e0e0;
  border: 1px solid #3a3a3a;
  selection-background-color: #3498db;
  selection-color: #ffffff;
}

QComboBox QAbstractItemView::item:hover {
  background-color: #333333;
}

QCheckBox {
  color: #e0e0e0;
  spacing: 8px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #3a3a3a;
  border-radius: 3px;
  background-color: #252525;
}

QCheckBox::indicator:hover {
  border-color: #4cc9f0;
}

QCheckBox::indicator:checked {
  background-color: #676767;
  border-color: #676767;
}

QCheckBox::indicator:checked:hover {
  background-color: #888888;
  border-color: #4cc9f0;
}

QCheckBox::indicator:disabled {
  background-color: #333333;
  border-color: #555555;
}

QSpinBox {
  background-color: #252525;
  color: #e0e0e0;
  border: 1px solid #3a3a3a;
  border-radius: 4px;
  padding: 5px 28px 5px 8px;
}

QSpinBox:hover {
  border-color: #4cc9f0;
}

QSpinBox:focus {
  border: 2px solid #3498db;
}

QSpinBox::up-button,
QSpinBox::down-button {
  background-color: #2d2d2d;
  border-left: 1px solid #3a3a3a;
  width: 20px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
  background-color: #383838;
}

QLineEdit,
QTextEdit {
  background-color: #252525;
  color: #e0e0e0;
  border: 1px solid #3a3a3a;
  border-radius: 4px;
}

QLineEdit:hover,
QTextEdit:hover {
  border-color: #4cc9f0;
}

QLineEdit:focus,
QTextEdit:focus {
  border: 2px solid #3498db;
}

/* Named components */

QLabel#resistanceLabel {
  color: #00ffcc;
  border: 2px solid #3a3a3a;
  background: #111111;
}

QPushButton#loadRecipeButton {
  background-color: #3a3a3a;
  color: #e0e0e0;
}

QPushButton#loadRecipeButton:hover {
  background-color: #4a4a4a;
  border-color: #666666;
}

QPushButton#loadRecipeButton:disabled {
  background-color: #252525;
  color: #777777;
}

QPushButton#runRecipeButton {
  background-color: #27ae60;
}

QPushButton#runRecipeButton:hover {
  background-color: #2ecc71;
}

QPushButton#runRecipeButton:disabled {
  background-color: #1f4d32;
  color: #777777;
}

QPushButton#manualSessionButton {
  background-color: #2980b9;
}

QPushButton#manualSessionButton:hover {
  background-color: #3498db;
}

QPushButton#manualSessionButton:disabled {
  background-color: #1f3d55;
  color: #777777;
}

QPushButton#applySetpointButton {
  background-color: #8e44ad;
}

QPushButton#applySetpointButton:hover {
  background-color: #9b59b6;
}

QPushButton#applySetpointButton:disabled {
  background-color: #493052;
  color: #777777;
}

QPushButton#stopButton {
  background-color: #c0392b;
}

QPushButton#stopButton:hover {
  background-color: #e74c3c;
}

QPushButton#stopButton:disabled {
  background-color: #542b27;
  color: #777777;
}

QTextEdit#consoleLogText {
  background-color: #1e1e1e;
  color: #64e314;
}
