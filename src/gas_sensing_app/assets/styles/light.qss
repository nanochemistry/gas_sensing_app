QMainWindow {
  background-color: #f5f5f5;
}

QWidget {
  background-color: #ffffff;
  color: #222222;
}

QFrame {
  background-color: #ffffff;
  border: 1px solid #d6d6d6;
}

QTabWidget::pane {
  border: 1px solid #d0d0d0;
  background-color: #ffffff;
}

QTabBar::tab {
  background-color: #eeeeee;
  color: #666666;
  border: 1px solid #d0d0d0;
  padding: 6px 12px;
}

QTabBar::tab:hover {
  color: #222222;
  background-color: #e2e2e2;
}

QTabBar::tab:selected {
  background-color: #ffffff;
  color: #222222;
  border-bottom: 2px solid #3498db;
}

QGroupBox {
  border: 1px solid #cccccc;
  border-radius: 4px;
  margin-top: 8px;
}

QGroupBox::title {
  color: #555555;
}

QLabel {
  background-color: transparent;
  color: #222222;
}

QPushButton {
  color: #ffffff;
  border-radius: 4px;
  border: 1px solid transparent;
  padding: 6px 12px;
}

QPushButton:hover {
  border: 1px solid #bbbbbb;
}

QPushButton:disabled {
  background-color: #dddddd;
  color: #999999;
  border: 1px solid #cccccc;
}

QPushButton:hover:disabled {
  background-color: inherit;
}

QComboBox {
  background-color: #ffffff;
  color: #222222;
  border: 1px solid #cccccc;
  border-radius: 4px;
  padding: 5px 10px;
}

QComboBox:hover {
  border-color: #4cc9f0;
}

QComboBox:focus {
  border: 2px solid #3498db;
}

QComboBox::drop-down {
  width: 24px;
  border: none;
  background-color: #f0f0f0;
  border-left: 1px solid #cccccc;
}

QComboBox::drop-down:hover {
  background-color: #e4e4e4;
}

QComboBox QAbstractItemView {
  background-color: #ffffff;
  color: #222222;
  border: 1px solid #cccccc;
  selection-background-color: #3498db;
  selection-color: #ffffff;
}

QComboBox QAbstractItemView::item:hover {
  background-color: #eeeeee;
}

QCheckBox {
  color: #222222;
  spacing: 8px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #aaaaaa;
  border-radius: 3px;
  background-color: #ffffff;
}

QCheckBox::indicator:hover {
  border-color: #4cc9f0;
}

QCheckBox::indicator:checked {
  background-color: #dddddd;
  border-color: #dddddd;
}

QCheckBox::indicator:checked:hover {
  background-color: #aaaaaa;
  border-color: #aaaaaa;
}

QCheckBox::indicator:disabled {
  background-color: #eeeeee;
  border-color: #cccccc;
}

QSpinBox {
  background-color: #ffffff;
  color: #222222;
  border: 1px solid #cccccc;
  border-radius: 4px;
  padding: 5px 28px 5px 8px;
}

QSpinBox:hover {
  border-color: #4cc9f0;
}

QSpinBox:focus {
  border: 2px solid #3498db;
}

QSpinBox::up-button,
QSpinBox::down-button {
  background-color: #eeeeee;
  border-left: 1px solid #cccccc;
  width: 20px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
  background-color: #dddddd;
}

QLineEdit,
QTextEdit {
  background-color: #ffffff;
  color: #222222;
  border: 1px solid #cccccc;
  border-radius: 4px;
}

QLineEdit:hover,
QTextEdit:hover {
  border-color: #4cc9f0;
}

QLineEdit:focus,
QTextEdit:focus {
  border: 2px solid #3498db;
}

/* Named components */

QLabel#resistanceLabel {
  color: #008f7a;
  border: 2px solid #cccccc;
  background: #fafafa;
}

QPushButton#loadRecipeButton {
  background-color: #666666;
  color: #ffffff;
}

QPushButton#loadRecipeButton:hover {
  background-color: #777777;
  border-color: #999999;
}

QPushButton#loadRecipeButton:disabled {
  background-color: #dddddd;
  color: #999999;
}

QPushButton#runRecipeButton {
  background-color: #27ae60;
}

QPushButton#runRecipeButton:hover {
  background-color: #2ecc71;
}

QPushButton#runRecipeButton:disabled {
  background-color: #b9d9c5;
  color: #999999;
}

QPushButton#manualSessionButton {
  background-color: #2980b9;
}

QPushButton#manualSessionButton:hover {
  background-color: #3498db;
}

QPushButton#manualSessionButton:disabled {
  background-color: #b9d2e1;
  color: #999999;
}

QPushButton#applySetpointButton {
  background-color: #8e44ad;
}

QPushButton#applySetpointButton:hover {
  background-color: #9b59b6;
}

QPushButton#applySetpointButton:disabled {
  background-color: #d3c1dc;
  color: #999999;
}

QPushButton#stopButton {
  background-color: #c0392b;
}

QPushButton#stopButton:hover {
  background-color: #e74c3c;
}

QPushButton#stopButton:disabled {
  background-color: #dfbbb7;
  color: #999999;
}

QTextEdit#consoleLogText {
  background-color: #ffffff;
  color: #2e8b57;
}
